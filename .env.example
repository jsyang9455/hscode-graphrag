# TradeFlow HSCode-GraphRAG
APP_ENV=production
SECRET_KEY=change-me-in-production

# Database (Docker Compose default)
DATABASE_URL=postgresql+psycopg2://hscode:hscode@db:5432/hscode_graphrag

# Local fallback (no Docker)
# DATABASE_URL=sqlite:///./data/runtime/hscode.db

# Optional LLM (rule-based demo works without this)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
USE_LLM=false

# Confidence thresholds (tiered review)
THETA_HIGH=0.75
THETA_LOW=0.45

# API
API_HOST=0.0.0.0
API_PORT=8000
# Browser origins — on AWS add http://YOUR_EC2_IP:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000

# AWS (optional)
AWS_REGION=ap-northeast-2
AWS_ECR_REPO=tradeflow-hscode-graphrag
